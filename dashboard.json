{
    "name": "Stellar Global Supplies — Cloudflare Monitor",
    "description": "Full platform observability: traffic, workers, builds, errors, usage. Powered by CloudflareCronSummary, CloudflareWorkerMetric, CloudflareSiteMetric, CloudflarePagesBuild, CloudflareAccountUsage.",
    "permissions": "PUBLIC_READ_WRITE",
    "pages": [
  
      {
        "name": "📊 Overview",
        "description": "Master at-a-glance across all apps and workers",
        "widgets": [
          {
            "title": "Total Apps",
            "layout": { "column": 1, "row": 1, "width": 2, "height": 3 },
            "visualization": { "id": "viz.billboard" },
            "rawConfiguration": {
              "nrqlQueries": [{ "accountIds": [8314321], "query": "SELECT latest(totalApps) AS 'Apps' FROM CloudflareCronSummary SINCE 10 minutes ago" }],
              "thresholds": []
            }
          },
          {
            "title": "Total Workers",
            "layout": { "column": 3, "row": 1, "width": 2, "height": 3 },
            "visualization": { "id": "viz.billboard" },
            "rawConfiguration": {
              "nrqlQueries": [{ "accountIds": [8314321], "query": "SELECT latest(totalWorkers) AS 'Workers' FROM CloudflareCronSummary SINCE 10 minutes ago" }],
              "thresholds": []
            }
          },
          {
            "title": "Worker Invocations (30 min)",
            "layout": { "column": 5, "row": 1, "width": 2, "height": 3 },
            "visualization": { "id": "viz.billboard" },
            "rawConfiguration": {
              "nrqlQueries": [{ "accountIds": [8314321], "query": "SELECT sum(invocations) AS 'Invocations' FROM CloudflareWorkerMetric SINCE 30 minutes ago" }],
              "thresholds": []
            }
          },
          {
            "title": "Site Requests (30 min)",
            "layout": { "column": 7, "row": 1, "width": 2, "height": 3 },
            "visualization": { "id": "viz.billboard" },
            "rawConfiguration": {
              "nrqlQueries": [{ "accountIds": [8314321], "query": "SELECT sum(requests) AS 'Requests' FROM CloudflareSiteMetric SINCE 30 minutes ago" }],
              "thresholds": []
            }
          },
          {
            "title": "Unique Visitors (30 min)",
            "layout": { "column": 9, "row": 1, "width": 2, "height": 3 },
            "visualization": { "id": "viz.billboard" },
            "rawConfiguration": {
              "nrqlQueries": [{ "accountIds": [8314321], "query": "SELECT sum(uniqueVisitors) AS 'Visitors' FROM CloudflareSiteMetric SINCE 30 minutes ago" }],
              "thresholds": []
            }
          },
          {
            "title": "Global Worker Error Rate %",
            "layout": { "column": 11, "row": 1, "width": 2, "height": 3 },
            "visualization": { "id": "viz.billboard" },
            "rawConfiguration": {
              "nrqlQueries": [{ "accountIds": [8314321], "query": "SELECT latest(globalErrorRate) AS 'Error Rate %' FROM CloudflareCronSummary SINCE 10 minutes ago" }],
              "thresholds": [
                { "alertSeverity": "WARNING", "value": 1 },
                { "alertSeverity": "CRITICAL", "value": 5 }
              ]
            }
          },
          {
            "title": "Site Requests Over Time — All Apps",
            "layout": { "column": 1, "row": 4, "width": 6, "height": 3 },
            "visualization": { "id": "viz.line" },
            "rawConfiguration": {
              "nrqlQueries": [{ "accountIds": [8314321], "query": "SELECT sum(requests) FROM CloudflareSiteMetric FACET appName TIMESERIES 3 minutes SINCE 3 hours ago" }],
              "yAxisLeft": { "zero": true }
            }
          },
          {
            "title": "Worker Invocations Over Time — By App",
            "layout": { "column": 7, "row": 4, "width": 6, "height": 3 },
            "visualization": { "id": "viz.line" },
            "rawConfiguration": {
              "nrqlQueries": [{ "accountIds": [8314321], "query": "SELECT sum(invocations) FROM CloudflareWorkerMetric FACET appName TIMESERIES 3 minutes SINCE 3 hours ago" }],
              "yAxisLeft": { "zero": true }
            }
          },
          {
            "title": "Worker Error Rate % Over Time",
            "layout": { "column": 1, "row": 7, "width": 4, "height": 3 },
            "visualization": { "id": "viz.line" },
            "rawConfiguration": {
              "nrqlQueries": [{ "accountIds": [8314321], "query": "SELECT sum(errors) / sum(invocations) * 100 AS 'Error Rate %' FROM CloudflareWorkerMetric TIMESERIES 3 minutes SINCE 3 hours ago" }],
              "yAxisLeft": { "zero": true }
            }
          },
          {
            "title": "5xx Site Errors Over Time",
            "layout": { "column": 5, "row": 7, "width": 4, "height": 3 },
            "visualization": { "id": "viz.line" },
            "rawConfiguration": {
              "nrqlQueries": [{ "accountIds": [8314321], "query": "SELECT sum(http5xx) FROM CloudflareSiteMetric FACET appName TIMESERIES 3 minutes SINCE 3 hours ago" }],
              "yAxisLeft": { "zero": true }
            }
          },
          {
            "title": "Cron Monitor Health",
            "layout": { "column": 9, "row": 7, "width": 4, "height": 3 },
            "visualization": { "id": "viz.line" },
            "rawConfiguration": {
              "nrqlQueries": [{ "accountIds": [8314321], "query": "SELECT latest(totalLogsPushed) AS 'Events pushed', latest(runDurationMs) AS 'Run ms' FROM CloudflareCronSummary TIMESERIES 3 minutes SINCE 3 hours ago" }],
              "yAxisLeft": { "zero": true }
            }
          },
          {
            "title": "Last 20 Cron Runs",
            "layout": { "column": 1, "row": 10, "width": 12, "height": 3 },
            "visualization": { "id": "viz.table" },
            "rawConfiguration": {
              "nrqlQueries": [{ "accountIds": [8314321], "query": "SELECT timestamp, runStatus, runDurationMs, totalLogsPushed, totalErrors, totalInvocations, totalRequests, totalWorkers FROM CloudflareCronSummary SINCE 1 hour ago LIMIT 20" }]
            }
          }
        ]
      },
  
